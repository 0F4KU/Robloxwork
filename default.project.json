{
	"name": "Obby Simplu",
	"tree": {
		"$className": "DataModel",

		"ServerScriptService": {
			"$ignoreUnknownInstances": true,
			"ObbyServer": { "$path": "src/server/ObbyServer.server.luau" },
			"ProgressionServer": { "$path": "src/server/ProgressionServer.server.luau" },
			"ZoneHazards": { "$path": "src/server/ZoneHazards.server.luau" },
			"Feedback": { "$path": "src/server/Feedback.luau" }
		},

		"ReplicatedStorage": {
			"$ignoreUnknownInstances": true,
			"Shared": {
				"$className": "Folder",
				"$ignoreUnknownInstances": true,
				"ProgressionConfig": { "$path": "src/shared/ProgressionConfig.luau" }
			},
			"Remotes": {
				"$className": "Folder",
				"$ignoreUnknownInstances": true,
				"AllocateStat": { "$className": "RemoteEvent" }
			}
