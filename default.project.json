		"StarterGui": {
			"$ignoreUnknownInstances": true,
			"MainMenu": {
				"$className": "ScreenGui",
				"$ignoreUnknownInstances": true,
				"MenuController": { "$path": "src/client/MenuController.client.luau" }
			},
			"HUD": {
				"$className": "ScreenGui",
				"$ignoreUnknownInstances": true,
				"HUDController": { "$path": "src/client/HUDController.client.luau" }
			}
		}
